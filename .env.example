# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paper_crawler
DATABASE_ECHO=false

# Application Settings
APP_NAME=Paper Crawler API
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api

# Official arXiv API Compliance
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf
ARXIV_RATE_LIMIT_SECONDS=3.0
ARXIV_USER_AGENT=PaperCrawler/1.0 (mailto:contact@papercrawler.local)
ARXIV_TIMEOUT_SECONDS=30.0
ARXIV_MAX_RETRIES=3

# Analysis & Vector Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_ANNOTATIONS_PER_PAPER=150
USE_LLM_ANALYZER=false

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
